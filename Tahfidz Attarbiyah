    <!-- ========================================== -->
    <!-- JAVASCRIPT LOGIC & STATE MANAGEMENT -->
    <!-- ========================================== -->
    <script>
        // Initial Data Seeds
        const defaultStudents = [
            { id: 1, name: "Ahmad", parentName: "Bapak H. Ahmad", className: "6 Tahfidz A" },
            { id: 2, name: "Fatimah Az-Zahra", parentName: "Bpk. Ridwan", className: "6 Tahfidz A" },
            { id: 3, name: "Umar Faruq", parentName: "Ibu Siti Aminah", className: "5 Tahfidz B" },
            { id: 4, name: "Aisyah Humaira", parentName: "Bpk. Zulkifli", className: "5 Tahfidz B" }
        ];

        const defaultTeachers = [
            { id: 1, name: "Ustadz H. Abdullah, S.Pd.I", nip: "GUR-2026-01" },
            { id: 2, name: "Ustadzah Maryam, S.Hum", nip: "GUR-2026-02" }
        ];

        const defaultSetoran = [
            { id: 101, studentId: 1, studentName: "Ahmad", surah: "An-Naba'", ayat: "1-15", status: "Mumtaz", date: "2026-06-01", notes: "Makhroj huruf qaf dan ha sudah sangat baik.", teacherName: "Ustadz H. Abdullah, S.Pd.I" },
            { id: 102, studentId: 1, studentName: "Ahmad", surah: "An-Naba'", ayat: "16-30", status: "Jayyid", date: "2026-06-03", notes: "Perhatikan panjang mad wajib muttasil.", teacherName: "Ustadz H. Abdullah, S.Pd.I" },
            { id: 103, studentId: 2, studentName: "Fatimah Az-Zahra", surah: "An-Nazi'at", ayat: "1-20", status: "Mumtaz", date: "2026-06-03", notes: "Sangat lancar dan tartil.", teacherName: "Ustadzah Maryam, S.Hum" },
            { id: 104, studentId: 3, studentName: "Umar Faruq", surah: "'Abasa", ayat: "1-15", status: "Muraja'ah", date: "2026-06-04", notes: "Ada beberapa ayat tertukar di tengah.", teacherName: "Ustadz H. Abdullah, S.Pd.I" }
        ];

        // State Manager with LocalStorage
        let students = JSON.parse(localStorage.getItem('tahfidz_students')) || defaultStudents;
        let teachers = JSON.parse(localStorage.getItem('tahfidz_teachers')) || defaultTeachers;
        let setoran = JSON.parse(localStorage.getItem('tahfidz_setoran')) || defaultSetoran;
        
        // Current Logged-In User State
        let currentUser = JSON.parse(localStorage.getItem('tahfidz_current_user')) || null;
        let loginRoleTab = 'admin'; // 'admin', 'guru', 'ortu'

        function saveData() {
            localStorage.setItem('tahfidz_students', JSON.stringify(students));
            localStorage.setItem('tahfidz_teachers', JSON.stringify(teachers));
            localStorage.setItem('tahfidz_setoran', JSON.stringify(setoran));
            localStorage.setItem('tahfidz_current_user', JSON.stringify(currentUser));
        }

        // Login Role Selector Tabs
        function setLoginRole(role) {
            loginRoleTab = role;
            const btnAdmin = document.getElementById('tab-login-admin');
            const btnGuru = document.getElementById('tab-login-guru');
            const btnOrtu = document.getElementById('tab-login-ortu');
            const credGroup = document.getElementById('credentials-group');
            const parentGroup = document.getElementById('parent-student-group');
            const errorDiv = document.getElementById('login-error');

            errorDiv.classList.add('hidden');

            // Reset tab styles
            [btnAdmin, btnGuru, btnOrtu].forEach(b => b.className = "py-2.5 rounded-xl transition-all text-slate-600 hover:text-slate-900");

            if (role === 'admin') {
                btnAdmin.className = "py-2.5 rounded-xl transition-all bg-white text-emerald-800 shadow-sm font-semibold";
                credGroup.classList.remove('hidden');
                parentGroup.classList.add('hidden');
                document.getElementById('login-username').value = "admin";
                document.getElementById('login-password').value = "admin123";
            } else if (role === 'guru') {
                btnGuru.className = "py-2.5 rounded-xl transition-all bg-white text-emerald-800 shadow-sm font-semibold";
                credGroup.classList.remove('hidden');
                parentGroup.classList.add('hidden');
                document.getElementById('login-username').value = "ustad";
                document.getElementById('login-password').value = "ustad123";
            } else if (role === 'ortu') {
                btnOrtu.className = "py-2.5 rounded-xl transition-all bg-white text-emerald-800 shadow-sm font-semibold";
                credGroup.classList.add('hidden');
                parentGroup.classList.remove('hidden');
                document.getElementById('login-child-name-input').value = "Ahmad";
            }
        }

        // Handle Login Submission
        function handleLogin(e) {
            e.preventDefault();
            const errorDiv = document.getElementById('login-error');
            const errorText = document.getElementById('login-error-text');

            if (loginRoleTab === 'admin') {
                const u = document.getElementById('login-username').value.trim();
                const p = document.getElementById('login-password').value.trim();
                if (u === 'admin' && p === 'admin123') {
                    currentUser = { role: 'admin', name: 'Administrator Utama' };
                } else {
                    errorText.innerText = "Username atau password admin salah (Gunakan admin / admin123).";
                    errorDiv.classList.remove('hidden');
                    return;
                }
            } else if (loginRoleTab === 'guru') {
                const u = document.getElementById('login-username').value.trim();
                const p = document.getElementById('login-password').value.trim();
                if (u === 'ustad' && p === 'ustad123') {
                    currentUser = { role: 'guru', name: 'Ustadz H. Abdullah, S.Pd.I' };
                } else {
                    errorText.innerText = "Username atau password guru salah (Gunakan ustad / ustad123).";
                    errorDiv.classList.remove('hidden');
                    return;
                }
            } else if (loginRoleTab === 'ortu') {
                const childInputName = document.getElementById('login-child-name-input').value.trim();
                if (!childInputName) {
                    errorText.innerText = "Silakan masukkan nama anak/santri terlebih dahulu.";
                    errorDiv.classList.remove('hidden');
                    return;
                }
                
                // Case-insensitive search in students list
                const matchedStudent = students.find(s => s.name.toLowerCase() === childInputName.toLowerCase());
                if (matchedStudent) {
                    currentUser = {
                        role: 'ortu',
                        name: `Wali dari ${matchedStudent.name}`,
                        studentId: matchedStudent.id,
                        studentName: matchedStudent.name
                    };
                } else {
                    errorText.innerText = `Nama anak "${childInputName}" tidak ditemukan. Periksa kembali pengetikan nama atau tambahkan siswa via admin.`;
                    errorDiv.classList.remove('hidden');
                    return;
                }
            }

            saveData();
            checkAuthState();
            showToast(`Berhasil masuk sebagai ${currentUser.name}`, 'success');
        }

        function handleLogout() {
            currentUser = null;
            saveData();
            checkAuthState();
            showToast('Anda telah keluar dari sistem.', 'info');
        }

        function checkAuthState() {
            const loginScreen = document.getElementById('login-screen');
            const appContainer = document.getElementById('app-container');

            if (!currentUser) {
                loginScreen.classList.remove('hidden');
                appContainer.classList.add('hidden');
                setLoginRole('admin'); // reset login tab
            } else {
                loginScreen.classList.add('hidden');
                appContainer.classList.remove('hidden');
                
                // Update header info
                document.getElementById('user-display-name').innerText = currentUser.name;
                const roleBadge = document.getElementById('user-role-badge');
                
                if (currentUser.role === 'admin') roleBadge.innerText = 'Administrator';
                else if (currentUser.role === 'guru') roleBadge.innerText = 'Guru / Ustad';
                else if (currentUser.role === 'ortu') roleBadge.innerText = 'Orang Tua / Wali';

                // Render respective view
                renderAppView();
            }
        }

        function renderAppView() {
            document.getElementById('view-admin').classList.add('hidden');
            document.getElementById('view-guru').classList.add('hidden');
            document.getElementById('view-ortu').classList.add('hidden');

            if (currentUser.role === 'admin') {
                document.getElementById('view-admin').classList.remove('hidden');
                renderAdminView();
            } else if (currentUser.role === 'guru') {
                document.getElementById('view-guru').classList.remove('hidden');
                renderGuruView();
            } else if (currentUser.role === 'ortu') {
                document.getElementById('view-ortu').classList.remove('hidden');
                renderOrtuView();
            }
        }

        // Render Admin View
        function renderAdminView() {
            document.getElementById('stat-total-students').innerText = students.length;
            document.getElementById('stat-total-teachers').innerText = teachers.length;
            document.getElementById('stat-total-setoran').innerText = setoran.length;

            // Students table
            const studentTbody = document.getElementById('admin-student-list');
            studentTbody.innerHTML = students.map(s => `
                <tr class="hover:bg-slate-50/50">
                    <td class="px-6 py-3 font-medium text-slate-800">${s.name}</td>
                    <td class="px-6 py-3 text-slate-600">${s.parentName}</td>
                    <td class="px-6 py-3 text-slate-500">${s.className}</td>
                    <td class="px-6 py-3 text-right">
                        <button onclick="deleteStudent(${s.id})" class="text-rose-500 hover:text-rose-700 font-medium px-2 py-1 rounded">Hapus</button>
                    </td>
                </tr>
            `).join('');

            // Teachers table
            const teacherTbody = document.getElementById('admin-teacher-list');
            teacherTbody.innerHTML = teachers.map(t => `
                <tr class="hover:bg-slate-50/50">
                    <td class="px-6 py-3 font-medium text-slate-800">${t.name}</td>
                    <td class="px-6 py-3 text-slate-600">${t.nip}</td>
                    <td class="px-6 py-3 text-right">
                        <button onclick="deleteTeacher(${t.id})" class="text-rose-500 hover:text-rose-700 font-medium px-2 py-1 rounded">Hapus</button>
                    </td>
                </tr>
            `).join('');

            // Filtered Setoran table
            const searchVal = document.getElementById('admin-search').value.toLowerCase();
            const filteredSetoran = setoran.filter(st => 
                st.studentName.toLowerCase().includes(searchVal) || st.surah.toLowerCase().includes(searchVal)
            );

            const setoranTbody = document.getElementById('admin-setoran-list');
            if (filteredSetoran.length === 0) {
                setoranTbody.innerHTML = `<tr><td colspan="6" class="px-6 py-6 text-center text-slate-400">Tidak ada riwayat setoran yang cocok.</td></tr>`;
            } else {
                setoranTbody.innerHTML = filteredSetoran.map(st => `
                    <tr class="hover:bg-slate-50/50">
                        <td class="px-6 py-3 text-slate-600">${st.date}</td>
                        <td class="px-6 py-3 font-medium text-slate-800">${st.studentName}</td>
                        <td class="px-6 py-3 text-slate-700 font-medium">Q.S. ${st.surah} (Ayat ${st.ayat})</td>
                        <td class="px-6 py-3">${renderStatusBadge(st.status)}</td>
                        <td class="px-6 py-3 text-slate-600">${st.teacherName}</td>
                        <td class="px-6 py-3 text-slate-500 italic">${st.notes || '-'}</td>
                    </tr>
                `).join('');
            }
        }

        // Render Guru View
        function renderGuruView() {
            const selectEl = document.getElementById('input-student');
            selectEl.innerHTML = students.map(s => `<option value="${s.id}">${s.name} (${s.className})</option>`).join('');

            const dateInput = document.getElementById('input-date');
            if (!dateInput.value) {
                dateInput.value = new Date().toISOString().split('T')[0];
            }

            const searchVal = document.getElementById('guru-search').value.toLowerCase();
            const filteredSetoran = setoran.filter(st => st.studentName.toLowerCase().includes(searchVal));

            const guruSetoranTbody = document.getElementById('guru-setoran-list');
            if (filteredSetoran.length === 0) {
                guruSetoranTbody.innerHTML = `<tr><td colspan="6" class="px-6 py-6 text-center text-slate-400">Belum ada data setoran.</td></tr>`;
            } else {
                guruSetoranTbody.innerHTML = filteredSetoran.map(st => `
                    <tr class="hover:bg-slate-50/50">
                        <td class="px-6 py-3 text-slate-600">${st.date}</td>
                        <td class="px-6 py-3 font-medium text-slate-800">${st.studentName}</td>
                        <td class="px-6 py-3 text-slate-700 font-medium">Q.S. ${st.surah} (${st.ayat})</td>
                        <td class="px-6 py-3">${renderStatusBadge(st.status)}</td>
                        <td class="px-6 py-3 text-slate-500">${st.notes || '-'}</td>
                        <td class="px-6 py-3 text-right">
                            <button onclick="deleteSetoran(${st.id})" class="text-rose-500 hover:text-rose-700 font-medium px-2 py-1 rounded">Hapus</button>
                        </td>
                    </tr>
                `).join('');
            }
        }

        // Render Ortu View (Restricted to logged-in child's studentId)
        function renderOrtuView() {
            const childId = currentUser.studentId;
            const childObj = students.find(s => s.id === childId);
            const childName = childObj ? childObj.name : currentUser.studentName;

            document.getElementById('ortu-welcome-title').innerText = `Selamat Datang, Wali dari ${childName}`;
            document.getElementById('ortu-child-name').innerText = childName;

            const childSetoran = setoran.filter(st => st.studentId === childId);
            document.getElementById('ortu-total-setoran').innerText = childSetoran.length;

            const ortuTbody = document.getElementById('ortu-setoran-list');
            if (childSetoran.length === 0) {
                ortuTbody.innerHTML = `<tr><td colspan="5" class="px-6 py-6 text-center text-slate-400">Belum ada riwayat setoran hafalan untuk ananda ${childName}.</td></tr>`;
            } else {
                ortuTbody.innerHTML = childSetoran.map(st => `
                    <tr class="hover:bg-slate-50/50">
                        <td class="px-6 py-3 text-slate-600">${st.date}</td>
                        <td class="px-6 py-3 font-medium text-slate-800">Q.S. ${st.surah} (Ayat ${st.ayat})</td>
                        <td class="px-6 py-3">${renderStatusBadge(st.status)}</td>
                        <td class="px-6 py-3 text-slate-600">${st.teacherName}</td>
                        <td class="px-6 py-3 text-slate-500 italic">${st.notes || '-'}</td>
                    </tr>
                `).join('');
            }
        }

        // Status Badge Helper
        function renderStatusBadge(status) {
            if (status === 'Mumtaz') {
                return `<span class="bg-emerald-50 text-emerald-700 px-2.5 py-1 rounded-full font-semibold text-[10px] border border-emerald-200">Mumtaz</span>`;
            } else if (status === 'Jayyid') {
                return `<span class="bg-teal-50 text-teal-700 px-2.5 py-1 rounded-full font-semibold text-[10px] border border-teal-200">Jayyid</span>`;
            } else if (status === 'Maqbul') {
                return `<span class="bg-sky-50 text-sky-700 px-2.5 py-1 rounded-full font-semibold text-[10px] border border-sky-200">Maqbul</span>`;
            } else {
                return `<span class="bg-amber-50 text-amber-700 px-2.5 py-1 rounded-full font-semibold text-[10px] border border-amber-200">Muraja'ah</span>`;
            }
        }

        // Form Submission Actions
        function handleSetoranSubmit(e) {
            e.preventDefault();
            const studentId = parseInt(document.getElementById('input-student').value);
            const studentObj = students.find(s => s.id === studentId);
            
            const newLog = {
                id: Date.now(),
