```html
<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>TahfidzApp - Sistem Setoran Hafalan Al-Qur'an</title>
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- FontAwesome Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <!-- Google Fonts Inter -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <style>
        body { font-family: 'Inter', sans-serif; }
    </style>
</head>
<body class="bg-slate-50 text-slate-800 min-h-screen flex flex-col justify-between">

    <!-- ========================================== -->
    <!-- LOGIN SCREEN (Default State) -->
    <!-- ========================================== -->
    <div id="login-screen" class="fixed inset-0 bg-slate-900/60 backdrop-blur-sm z-50 flex items-center justify-center p-4">
        <div class="bg-white rounded-3xl max-w-md w-full p-8 shadow-2xl border border-slate-100 transform transition-all">
            <div class="text-center mb-6">
                <div class="inline-flex bg-emerald-100 p-3.5 rounded-2xl text-emerald-700 mb-3 shadow-inner">
                    <i class="fa-solid fa-book-quran text-3xl"></i>
                </div>
                <h1 class="text-2xl font-bold text-slate-800">TahfidzApp Login</h1>
                <p class="text-xs text-slate-500 mt-1">Sistem Pencatatan & Monitoring Setoran Al-Qur'an</p>
            </div>

            <!-- Login Role Tabs -->
            <div class="grid grid-cols-3 gap-1 bg-slate-100 p-1 rounded-2xl mb-6 text-xs font-semibold">
                <button type="button" onclick="setLoginRole('admin')" id="tab-login-admin" class="py-2.5 rounded-xl transition-all bg-white text-emerald-800 shadow-sm">Admin</button>
                <button type="button" onclick="setLoginRole('guru')" id="tab-login-guru" class="py-2.5 rounded-xl transition-all text-slate-600 hover:text-slate-900">Guru / Ustad</button>
                <button type="button" onclick="setLoginRole('ortu')" id="tab-login-ortu" class="py-2.5 rounded-xl transition-all text-slate-600 hover:text-slate-900">Orang Tua</button>
            </div>

            <!-- Login Form -->
            <form id="form-login" onsubmit="handleLogin(event)" class="space-y-4">
                <!-- Username / Password Inputs (For Admin & Guru) -->
                <div id="credentials-group">
                    <div class="mb-3">
                        <label class="block text-xs font-medium text-slate-600 mb-1.5">Username</label>
                        <div class="relative">
                            <span class="absolute inset-y-0 left-0 pl-3.5 flex items-center text-slate-400">
                                <i class="fa-solid fa-user text-xs"></i>
                            </span>
                            <input type="text" id="login-username" placeholder="Masukkan username..." class="w-full pl-10 pr-4 py-2.5 text-xs rounded-xl border border-slate-200 focus:outline-none focus:ring-2 focus:ring-emerald-500 bg-slate-50/50">
                        </div>
                    </div>
                    <div>
                        <label class="block text-xs font-medium text-slate-600 mb-1.5">Password</label>
                        <div class="relative">
                            <span class="absolute inset-y-0 left-0 pl-3.5 flex items-center text-slate-400">
                                <i class="fa-solid fa-lock text-xs"></i>
                            </span>
                            <input type="password" id="login-password" placeholder="Masukkan password..." class="w-full pl-10 pr-4 py-2.5 text-xs rounded-xl border border-slate-200 focus:outline-none focus:ring-2 focus:ring-emerald-500 bg-slate-50/50">
                        </div>
                    </div>
                </div>

                <!-- Child Name Input (For Orang Tua Role - No Password Required) -->
                <div id="parent-student-group" class="hidden">
                    <label class="block text-xs font-medium text-slate-600 mb-1.5">Ketik Nama Anak / Santri</label>
                    <div class="relative">
                        <span class="absolute inset-y-0 left-0 pl-3.5 flex items-center text-slate-400">
                            <i class="fa-solid fa-child text-xs"></i>
                        </span>
                        <input type="text" id="login-child-name-input" placeholder="Cth: Ahmad" class="w-full pl-10 pr-4 py-2.5 text-xs rounded-xl border border-slate-200 focus:outline-none focus:ring-2 focus:ring-emerald-500 bg-slate-50/50">
                    </div>
                    <p class="text-[11px] text-slate-400 mt-2 italic">*Orang tua cukup mengetik nama lengkap anak untuk langsung melihat laporan hafalan tanpa sandi.</p>
                </div>

                <!-- Error Message Banner -->
                <div id="login-error" class="hidden bg-rose-50 border border-rose-200 text-rose-700 text-xs p-3 rounded-xl flex items-center gap-2">
                    <i class="fa-solid fa-circle-exclamation"></i>
                    <span id="login-error-text">Terjadi kesalahan akses.</span>
                </div>

                <button type="submit" class="w-full bg-emerald-600 hover:bg-emerald-700 text-white font-medium py-3 rounded-xl text-xs transition-all shadow-md shadow-emerald-600/20 flex items-center justify-center gap-2 mt-2">
                    <i class="fa-solid fa-right-to-bracket"></i> Masuk / Lihat Laporan
                </button>
            </form>

            <!-- Demo Credentials Helper -->
            <div class="mt-6 pt-5 border-t border-slate-100 text-[11px] text-slate-400 space-y-1">
                <p class="font-semibold text-slate-600">Panduan Akses:</p>
                <p>• Admin: <code class="bg-slate-100 px-1.5 py-0.5 rounded text-slate-600 font-mono">admin</code> / <code class="bg-slate-100 px-1.5 py-0.5 rounded text-slate-600 font-mono">admin123</code></p>
                <p>• Ustad/Guru: <code class="bg-slate-100 px-1.5 py-0.5 rounded text-slate-600 font-mono">ustad</code> / <code class="bg-slate-100 px-1.5 py-0.5 rounded text-slate-600 font-mono">ustad123</code></p>
                <p>• Orang Tua: Pilih tab "Orang Tua" lalu ketik nama anak (Cth: <code class="bg-slate-100 px-1.5 py-0.5 rounded text-slate-600 font-mono">Ahmad</code>)</p>
            </div>
        </div>
    </div>


    <!-- ========================================== -->
    <!-- MAIN APPLICATION CONTAINER (Hidden until login) -->
    <!-- ========================================== -->
    <div id="app-container" class="hidden flex-grow flex flex-col">
        <!-- Top Navigation Bar -->
        <header class="bg-emerald-800 text-white shadow-md sticky top-0 z-40">
            <div class="max-w-7xl mx-auto px-4 py-3 flex justify-between items-center">
                <div class="flex items-center gap-3">
                    <div class="bg-emerald-700 p-2.5 rounded-xl border border-emerald-600 shadow-inner">
                        <i class="fa-solid fa-book-quran text-xl text-emerald-200"></i>
                    </div>
                    <div>
                        <h1 class="font-bold text-sm md:text-base tracking-wide">TahfidzApp</h1>
                        <p class="text-[11px] text-emerald-200 hidden sm:block">Sistem Pencatatan Setoran Al-Qur'an</p>
                    </div>
                </div>

                <!-- User Info & Logout -->
                <div class="flex items-center gap-3">
                    <div class="text-right hidden sm:block">
                        <p id="user-display-name" class="text-xs font-semibold text-white">Nama Pengguna</p>
                        <span id="user-role-badge" class="inline-block px-2 py-0.5 rounded-full text-[10px] font-medium bg-emerald-900 text-emerald-200 border border-emerald-700">Role</span>
                    </div>
                    <button onclick="handleLogout()" class="bg-emerald-900/80 hover:bg-rose-600 text-emerald-100 hover:text-white px-3.5 py-2 rounded-xl text-xs font-medium transition-all flex items-center gap-1.5 border border-emerald-700/60 shadow-sm" title="Keluar Akun">
                        <i class="fa-solid fa-power-off"></i> <span class="hidden md:inline">Keluar</span>
                    </button>
                </div>
            </div>
        </header>

        <!-- Main Content Area -->
        <main class="flex-grow max-w-7xl w-full mx-auto px-4 py-6">
            
            <!-- Toast Notification Banner -->
            <div id="toast" class="hidden mb-6 p-4 rounded-xl border flex items-center justify-between text-xs sm:text-sm shadow-sm transition-all">
                <span id="toast-message"></span>
                <button onclick="hideToast()" class="text-slate-500 hover:text-slate-800 font-bold">&times;</button>
            </div>

            <!-- ================= ROLE: ADMIN VIEW ================= -->
            <div id="view-admin" class="space-y-6 hidden">
                <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4 bg-white p-6 rounded-2xl shadow-sm border border-slate-100">
                    <div>
                        <span class="bg-indigo-50 text-indigo-700 text-xs font-semibold px-2.5 py-1 rounded-full uppercase tracking-wider">Panel Administrator</span>
                        <h2 class="text-xl font-bold text-slate-800 mt-1">Dashboard & Manajemen Data</h2>
                        <p class="text-sm text-slate-500">Kelola data siswa, guru, serta pantau keseluruhan aktivitas setoran.</p>
                    </div>
                    <div class="flex flex-wrap gap-2">
                        <button onclick="openModal('modal-add-student')" class="bg-indigo-600 hover:bg-indigo-700 text-white text-xs font-medium px-4 py-2.5 rounded-xl transition-all shadow-sm flex items-center gap-2">
                            <i class="fa-solid fa-user-plus"></i> Tambah Siswa
                        </button>
                        <button onclick="openModal('modal-add-teacher')" class="bg-emerald-600 hover:bg-emerald-700 text-white text-xs font-medium px-4 py-2.5 rounded-xl transition-all shadow-sm flex items-center gap-2">
                            <i class="fa-solid fa-user-tie"></i> Tambah Guru
                        </button>
                    </div>
                </div>

                <!-- Stats Grid -->
                <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
                    <div class="bg-white p-5 rounded-2xl border border-slate-100 shadow-sm flex items-center gap-4">
                        <div class="w-12 h-12 rounded-xl bg-indigo-50 text-indigo-600 flex items-center justify-center text-xl font-bold">
                            <i class="fa-solid fa-graduation-cap"></i>
                        </div>
                        <div>
                            <p class="text-xs text-slate-500 font-medium">Total Siswa</p>
                            <h3 id="stat-total-students" class="text-2xl font-bold text-slate-800">0</h3>
                        </div>
                    </div>
                    <div class="bg-white p-5 rounded-2xl border border-slate-100 shadow-sm flex items-center gap-4">
                        <div class="w-12 h-12 rounded-xl bg-emerald-50 text-emerald-600 flex items-center justify-center text-xl font-bold">
                            <i class="fa-solid fa-chalkboard-user"></i>
                        </div>
                        <div>
                            <p class="text-xs text-slate-500 font-medium">Total Guru / Ustadz</p>
                            <h3 id="stat-total-teachers" class="text-2xl font-bold text-slate-800">0</h3>
                        </div>
                    </div>
                    <div class="bg-white p-5 rounded-2xl border border-slate-100 shadow-sm flex items-center gap-4">
                        <div class="w-12 h-12 rounded-xl bg-amber-50 text-amber-600 flex items-center justify-center text-xl font-bold">
                            <i class="fa-solid fa-book-bookmark"></i>
                        </div>
                        <div>
                            <p class="text-xs text-slate-500 font-medium">Total Setoran Tercatat</p>
                            <h3 id="stat-total-setoran" class="text-2xl font-bold text-slate-800">0</h3>
                        </div>
                    </div>
                </div>

                <!-- Data Management Tables -->
                <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
                    <!-- Students Table -->
                    <div class="bg-white rounded-2xl shadow-sm border border-slate-100 overflow-hidden">
                        <div class="px-6 py-4 border-b border-slate-100 flex justify-between items-center bg-slate-50/50">
                            <h3 class="font-semibold text-slate-800 text-sm flex items-center gap-2">
                                <i class="fa-solid fa-users text-indigo-600"></i> Daftar Siswa Tahfidz
                            </h3>
                        </div>
                        <div class="overflow-x-auto">
                            <table class="w-full text-left border-collapse">
                                <thead>
                                    <tr class="border-b border-slate-100 text-xs font-semibold text-slate-400 bg-slate-50">
                                        <th class="px-6 py-3">Nama Siswa</th>
                                        <th class="px-6 py-3">Orang Tua / Wali</th>
                                        <th class="px-6 py-3">Kelas</th>
                                        <th class="px-6 py-3 text-right">Aksi</th>
                                    </tr>
                                </thead>
                                <tbody id="admin-student-list" class="divide-y divide-slate-100 text-xs">
                                    <!-- Populated by JS -->
                                </tbody>
                            </table>
                        </div>
                    </div>

                    <!-- Teachers Table -->
                    <div class="bg-white rounded-2xl shadow-sm border border-slate-100 overflow-hidden">
                        <div class="px-6 py-4 border-b border-slate-100 flex justify-between items-center bg-slate-50/50">
                            <h3 class="font-semibold text-slate-800 text-sm flex items-center gap-2">
                                <i class="fa-solid fa-user-tie text-emerald-600"></i> Daftar Guru Pembimbing
                            </h3>
                        </div>
                        <div class="overflow-x-auto">
                            <table class="w-full text-left border-collapse">
                                <thead>
                                    <tr class="border-b border-slate-100 text-xs font-semibold text-slate-400 bg-slate-50">
                                        <th class="px-6 py-3">Nama Guru</th>
                                        <th class="px-6 py-3">NIP / ID</th>
                                        <th class="px-6 py-3 text-right">Aksi</th>
                                    </tr>
                                </thead>
                                <tbody id="admin-teacher-list" class="divide-y divide-slate-100 text-xs">
                                    <!-- Populated by JS -->
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>

                <!-- All Setoran Logs for Admin -->
                <div class="bg-white rounded-2xl shadow-sm border border-slate-100 overflow-hidden">
                    <div class="px-6 py-4 border-b border-slate-100 bg-slate-50/50 flex flex-col sm:flex-row justify-between items-start sm:items-center gap-3">
                        <h3 class="font-semibold text-slate-800 text-sm flex items-center gap-2">
                            <i class="fa-solid fa-clipboard-list text-amber-600"></i> Semua Riwayat Setoran Hafalan
                        </h3>
                        <div class="w-full sm:w-64">
                            <input type="text" id="admin-search" oninput="renderAdminView()" placeholder="Cari nama siswa / surah..." class="w-full px-3 py-1.5 text-xs rounded-xl border border-slate-200 focus:outline-none focus:ring-2 focus:ring-indigo-500 bg-white">
                        </div>
                    </div>
                    <div class="overflow-x-auto">
                        <table class="w-full text-left border-collapse">
                            <thead>
                                <tr class="border-b border-slate-100 text-xs font-semibold text-slate-400 bg-slate-50">
                                    <th class="px-6 py-3">Tanggal</th>
                                    <th class="px-6 py-3">Siswa</th>
                                    <th class="px-6 py-3">Surah & Ayat</th>
                                    <th class="px-6 py-3">Status</th>
                                    <th class="px-6 py-3">Guru Penguji</th>
                                    <th class="px-6 py-3">Catatan</th>
                                </tr>
                            </thead>
                            <tbody id="admin-setoran-list" class="divide-y divide-slate-100 text-xs">
                                <!-- Populated by JS -->
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

            <!-- ================= ROLE: GURU VIEW ================= -->
            <div id="view-guru" class="space-y-6 hidden">
                <div class="bg-white p-6 rounded-2xl shadow-sm border border-slate-100">
                    <span class="bg-emerald-50 text-emerald-700 text-xs font-semibold px-2.5 py-1 rounded-full uppercase tracking-wider">Panel Guru / Ustadz</span>
                    <h2 class="text-xl font-bold text-slate-800 mt-1">Input Setoran Hafalan Baru</h2>
                    <p class="text-sm text-slate-500">Catat perkembangan hafalan Al-Qur'an siswa dengan lengkap dan akurat.</p>
                </div>

                <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
                    <!-- Form Input Setoran -->
                    <div class="bg-white p-6 rounded-2xl shadow-sm border border-slate-100 h-fit">
                        <h3 class="font-semibold text-slate-800 text-sm mb-4 flex items-center gap-2">
                            <i class="fa-solid fa-pen-to-square text-emerald-600"></i> Form Setoran
                        </h3>
                        <form id="form-setoran" onsubmit="handleSetoranSubmit(event)" class="space-y-4">
                            <div>
                                <label class="block text-xs font-medium text-slate-600 mb-1">Pilih Siswa</label>
                                <select id="input-student" required class="w-full px-3 py-2 text-xs rounded-xl border border-slate-200 focus:outline-none focus:ring-2 focus:ring-emerald-500 bg-white">
                                    <!-- Populated by JS -->
                                </select>
                            </div>
                            <div>
                                <label class="block text-xs font-medium text-slate-600 mb-1">Nama Surah</label>
                                <select id="input-surah" required class="w-full px-3 py-2 text-xs rounded-xl border border-slate-200 focus:outline-none focus:ring-2 focus:ring-emerald-500 bg-white">
                                    <option value="">-- Pilih Surah --</option>
                                    <option value="Al-Fatihah">Al-Fatihah</option>
                                    <option value="An-Naba'">An-Naba'</option>
                                    <option value="An-Nazi'at">An-Nazi'at</option>
                                    <option value="'Abasa">Abasa</option>
                                    <option value="At-Takwir">At-Takwir</option>
                                    <option value="Al-Infitar">Al-Infitar</option>
                                    <option value="Al-Mutaffifin">Al-Mutaffifin</option>
                                    <option value="Al-Inshiqaq">Al-Inshiqaq</option>
                                    <option value="Al-Buruj">Al-Buruj</option>
                                    <option value="At-Tariq">At-Tariq</option>
                                    <option value="Al-A'la">Al-A'la</option>
                                    <option value="Al-Ghashiyah">Al-Ghashiyah</option>
                                    <option value="Al-Fajr">Al-Fajr</option>
                                    <option value="Al-Balad">Al-Balad</option>
                                    <option value="Ash-Shams">Ash-Shams</option>
                                    <option value="Al-Lail">Al-Lail</option>
                                    <option value="Ad-Duha">Ad-Duha</option>
                                    <option value="Ash-Sharh">Ash-Sharh</option>
                                    <option value="At-Tin">At-Tin</option>
                                    <option value="Al-Alaq">Al-Alaq</option>
                                    <option value="Al-Qadr">Al-Qadr</option>
                                    <option value="Al-Bayyinah">Al-Bayyinah</option>
                                    <option value="Az-Zalzalah">Az-Zalzalah</option>
                                    <option value="Al-'Adiyat">Al-'Adiyat</option>
                                    <option value="Al-Qari'ah">Al-Qari'ah</option>
                                    <option value="At-Takathur">At-Takathur</option>
                                    <option value="Al-'Asr">Al-'Asr</option>
                                    <option value="Al-Humazah">Al-Humazah</option>
                                    <option value="Al-Fil">Al-Fil</option>
                                    <option value="Quraisy">Quraisy</option>
                                    <option value="Al-Ma'un">Al-Ma'un</option>
                                    <option value="Al-Kauthar">Al-Kauthar</option>
                                    <option value="Al-Kafirun">Al-Kafirun</option>
                                    <option value="An-Nasr">An-Nasr</option>
                                    <option value="Al-Masad">Al-Masad</option>
                                    <option value="Al-Ikhlas">Al-Ikhlas</option>
                                    <option value="Al-Falaq">Al-Falaq</option>
                                    <option value="An-Nas">An-Nas</option>
                                    <option value="Al-Baqarah">Al-Baqarah (Lainnya)</option>
                                </select>
                            </div>
                            <div>
                                <label class="block text-xs font-medium text-slate-600 mb-1">Ayat (Contoh: 1-15)</label>
                                <input type="text" id="input-ayat" placeholder="Cth: 1-10" required class="w-full px-3 py-2 text-xs rounded-xl border border-slate-200 focus:outline-none focus:ring-2 focus:ring-emerald-500">
                            </div>
                            <div>
                                <label class="block text-xs font-medium text-slate-600 mb-1">Status Penilaian</label>
                                <select id="input-status" required class="w-full px-3 py-2 text-xs rounded-xl border border-slate-200 focus:outline-none focus:ring-2 focus:ring-emerald-500 bg-white">
                                    <option value="Mumtaz">Mumtaz (Sangat Baik / Sempurna)</option>
                                    <option value="Jayyid">Jayyid (Baik / Lancar)</option>
                                    <option value="Maqbul">Maqbul (Cukup / Perlu Koreksi)</option>
                                    <option value="Muraja'ah">Muraja'ah (Perlu Mengulang)</option>
                                </select>
                            </div>
                            <div>
                                <label class="block text-xs font-medium text-slate-600 mb-1">Tanggal Setoran</label>
                                <input type="date" id="input-date" required class="w-full px-3 py-2 text-xs rounded-xl border border-slate-200 focus:outline-none focus:ring-2 focus:ring-emerald-500">
                            </div>
                            <div>
                                <label class="block text-xs font-medium text-slate-600 mb-1">Catatan / Tajwid</label>
                                <textarea id="input-notes" rows="2" placeholder="Catatan tajwid atau kelancaran..." class="w-full px-3 py-2 text-xs rounded-xl border border-slate-200 focus:outline-none focus:ring-2 focus:ring-emerald-500"></textarea>
                            </div>
                            <div>
                                <label class="block text-xs font-medium text-slate-600 mb-1">Nama Guru Penguji</label>
                                <input type="text" id="input-teacher" value="Ustadz H. Abdullah, S.Pd.I" required class="w-full px-3 py-2 text-xs rounded-xl border border-slate-200 focus:outline-none focus:ring-2 focus:ring-emerald-500 bg-slate-50">
                            </div>
                            <button type="submit" class="w-full bg-emerald-600 hover:bg-emerald-700 text-white font-medium py-2.5 rounded-xl text-xs transition-all shadow-sm flex items-center justify-center gap-2">
                                <i class="fa-solid fa-floppy-disk"></i> Simpan Setoran
                            </button>
                        </form>
                    </div>

                    <!-- Recent History by Guru -->
                    <div class="lg:col-span-2 bg-white rounded-2xl shadow-sm border border-slate-100 overflow-hidden h-fit">
                        <div class="px-6 py-4 border-b border-slate-100 bg-slate-50/50 flex flex-col sm:flex-row justify-between items-start sm:items-center gap-3">
                            <h3 class="font-semibold text-slate-800 text-sm flex items-center gap-2">
                                <i class="fa-solid fa-clock-rotate-left text-emerald-600"></i> Riwayat Setoran Terbaru
                            </h3>
                            <div class="w-full sm:w-64">
                                <input type="text" id="guru-search" oninput="renderGuruView()" placeholder="Cari nama siswa..." class="w-full px-3 py-1.5 text-xs rounded-xl border border-slate-200 focus:outline-none focus:ring-2 focus:ring-emerald-500 bg-white">
                            </div>
                        </div>
                        <div class="overflow-x-auto">
                            <table class="w-full text-left border-collapse">
                                <thead>
                                    <tr class="border-b border-slate-100 text-xs font-semibold text-slate-400 bg-slate-50">
                                        <th class="px-6 py-3">Tanggal</th>
                                        <th class="px-6 py-3">Siswa</th>
                                        <th class="px-6 py-3">Surah & Ayat</th>
                                        <th class="px-6 py-3">Status</th>
                                        <th class="px-6 py-3">Catatan</th>
                                        <th class="px-6 py-3 text-right">Aksi</th>
                                    </tr>
                                </thead>
                                <tbody id="guru-setoran-list" class="divide-y divide-slate-100 text-xs">
                                    <!-- Populated by JS -->
                                </tbody>
